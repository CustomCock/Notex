/* Notex – erzeugt aus tokens.py. Platzhalter: @farbe, @sp_*, @r_*, @fs_*, @ly_*.
   Ruhig, flach, matt. Rahmen nur wo Flächenkontrast nicht reicht. */

* {
    outline: none;
}

QMainWindow, QWidget {
    background: @bg;
    color: @text;
    font-family: @ui_font;
    font-size: @fs_uipx;
}

/* ---------- Tooltips ---------- */
QToolTip {
    background: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: @r_controlpx;
    padding: @sp_xspx @sp_smpx;
    font-size: @fs_smallpx;
}

/* ---------- Seitenleiste ---------- */
QWidget#Sidebar, QWidget#Sidebar > QWidget {
    background: @sidebar;
}

QLineEdit {
    background: @surface;
    border: 1px solid transparent;
    border-radius: @r_controlpx;
    padding: 5px @sp_smpx;
    selection-background-color: @selection;
    selection-color: @text;
    color: @text;
}
QLineEdit:hover {
    background: @hover;
}
QLineEdit:focus {
    border: 1px solid @accent;
    background: @surface;
}
QFrame#SearchField {
    background: @surface;
    border: 1px solid transparent;
    border-radius: @r_controlpx;
}
QFrame#SearchField:hover {
    background: @hover;
}
QFrame#SearchField[focused="true"] {
    border: 1px solid @accent;
    background: @surface;
}
QLineEdit#SearchInput, QLineEdit#SearchInput:hover, QLineEdit#SearchInput:focus {
    background: transparent;
    border: none;
    padding: 0;
    border-radius: 0;
}
QLabel#SearchIcon {
    background: transparent;
}
QToolButton#SearchClear {
    background: transparent;
    border: none;
    padding: 2px;
    min-height: 0;
    border-radius: 4px;
}
QToolButton#SearchClear:hover {
    background: @selection;
}

/* Toggle-Chips (Name / Volltext) */
QToolButton#Chip {
    background: transparent;
    color: @text_muted;
    border: 1px solid @border;
    border-radius: @r_controlpx;
    padding: 2px @sp_mdpx;
    font-size: @fs_smallpx;
}
QToolButton#Chip:hover {
    background: @hover;
    color: @text;
}
QToolButton#Chip:checked {
    background: @selection;
    color: @text;
    border-color: @selection;
}
QToolButton#Chip:focus {
    border-color: @accent;
}

/* Baum und Trefferliste: Auswahl und Hover zeichnet die View selbst (abgerundet) */
QTreeView, QTreeWidget {
    background: @sidebar;
    border: none;
    show-decoration-selected: 0;
    padding: 0 @sp_xspx;
}
QTreeView::item, QTreeWidget::item {
    border: none;
    padding: 0 @sp_xspx;
    background: transparent;
    color: @text;
}
QTreeView::item:hover, QTreeWidget::item:hover,
QTreeView::item:selected, QTreeWidget::item:selected {
    background: transparent;
    color: @text;
}
QTreeView::branch {
    background: transparent;
    image: none;
    border-image: none;
}
QHeaderView::section {
    background: @sidebar;
    color: @text_muted;
    border: none;
    padding: @sp_xspx;
}

/* ---------- Editor-Tabs ---------- */
QTabWidget::pane {
    border: none;
    background: @bg;
}
QTabBar {
    background: @bg;
    qproperty-drawBase: 0;
}
QTabBar::tab {
    background: @bg;
    color: @text_muted;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0 @sp_lgpx;
    height: 34px;
    margin: 0;
}
QTabBar::tab:hover {
    background: @sidebar;
    color: @text;
}
QTabBar::tab:selected {
    background: @bg;
    color: @text;
    border-bottom: 2px solid @accent;
}
QTabBar::close-button {
    image: none;
}

/* Das Blatt: Hintergrund transparent – die weiße Fläche mit runden Ecken malt PaperFrame */
QTextEdit#Editor {
    background: transparent;
    color: @paper_text;
    border: none;
    selection-background-color: @paper_selection;
    selection-color: @paper_text;
    font-family: @editor_font;
}
QFrame#PaperFrame {
    background: @paper;
    border-radius: @r_panelpx;
}
QWidget#EditorPage {
    background: @bg;
}

/* Suchen/Ersetzen-Leiste */
QWidget#FindBar {
    background: @sidebar;
    border-top: 1px solid @border;
}
QWidget#FindBar QLineEdit {
    font-family: @editor_font;
}

/* ---------- Statusleiste ---------- */
QStatusBar {
    background: @sidebar;
    color: @text_muted;
    border-top: 1px solid @border;
    font-size: @fs_smallpx;
    min-height: @ly_status_heightpx;
    max-height: @ly_status_heightpx;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    background: transparent;
    color: @text_muted;
    font-size: @fs_smallpx;
    padding: 0 @sp_xspx;
}

/* ---------- Menüs ---------- */
QMenuBar {
    background: @bg;
    padding: 0 @sp_xspx;
}
QMenuBar::item {
    padding: @sp_xspx @sp_smpx;
    border-radius: @r_controlpx;
    color: @text_muted;
}
QMenuBar::item:selected {
    background: @hover;
    color: @text;
}
QMenu {
    background: @surface;
    border: 1px solid @border;
    border-radius: @r_panelpx;
    padding: 6px;
    margin: @sp_smpx;   /* Platz für den Schatten im transparenten Fenster */
}
QMenu::item {
    padding: 6px @sp_xlpx 6px @sp_mdpx;
    border-radius: @r_controlpx;
    color: @text;
}
QMenu::item:selected {
    background: @hover;
}
QMenu::item:disabled {
    color: @text_faint;
}
QMenu::separator {
    height: 1px;
    background: @border;
    margin: @sp_xspx @sp_smpx;
}
QMenu::icon {
    padding-left: @sp_smpx;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: @sp_xspx;
}

/* ---------- Buttons ---------- */
QPushButton, QToolButton {
    background: @surface;
    color: @text;
    border: 1px solid transparent;
    border-radius: @r_controlpx;
    padding: 5px @sp_mdpx;
    min-height: 18px;
}
QPushButton:hover, QToolButton:hover {
    background: @hover;
}
QPushButton:pressed, QToolButton:pressed {
    background: @selection;
}
QPushButton:focus, QToolButton:focus {
    border: 1px solid @accent;
}
QPushButton:default {
    border: 1px solid @accent;
}
QPushButton#Danger {
    color: @danger;
}
QPushButton#Danger:focus, QPushButton#Danger:default {
    border-color: @danger;
}
QToolButton#IconButton {
    background: transparent;
    border: 1px solid transparent;
    padding: @sp_xspx;
    min-height: 0;
}
QToolButton#IconButton:hover {
    background: @hover;
}
QToolButton#IconButton:checked {
    background: @selection;
}

QSplitter::handle {
    background: @bg;
}
QSplitter::handle:horizontal {
    width: 1px;
}

/* ---------- Scrollbars: schmal, rund, halbtransparent, bei Hover deutlicher ---------- */
QScrollBar:vertical {
    background: transparent;
    width: @ly_scrollbarpx;
    margin: 2px 0;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.14);
    min-height: 32px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:vertical:pressed {
    background: rgba(255, 255, 255, 0.30);
}
QScrollBar:horizontal {
    background: transparent;
    height: @ly_scrollbarpx;
    margin: 0 2px;
}
QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.14);
    min-width: 32px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover, QScrollBar::handle:horizontal:pressed {
    background: rgba(255, 255, 255, 0.30);
}
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0;
    height: 0;
}
/* Im weißen Blatt: dunkle Scrollbar-Griffe */
QTextEdit#Editor QScrollBar::handle:vertical, QTextEdit#Editor QScrollBar::handle:horizontal {
    background: rgba(0, 0, 0, 0.14);
}
QTextEdit#Editor QScrollBar::handle:vertical:hover, QTextEdit#Editor QScrollBar::handle:horizontal:hover {
    background: rgba(0, 0, 0, 0.30);
}

/* ---------- Dialoge ---------- */
QDialog, QMessageBox, QInputDialog {
    background: @surface;
}
QMessageBox QLabel, QInputDialog QLabel {
    color: @text;
    background: transparent;
}
QDialogButtonBox QPushButton, QMessageBox QPushButton {
    min-width: 88px;
}
QCheckBox {
    spacing: 6px;
    color: @text_muted;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @border;
    border-radius: 4px;
    background: @surface;
}
QCheckBox::indicator:checked {
    background: @accent;
    border-color: @accent;
}
QCheckBox:checked {
    color: @text;
}

/* ---------- Empty State / Toast ---------- */
QLabel#EmptyTitle {
    color: @text;
    font-size: @fs_titlepx;
    font-weight: 600;
}
QLabel#EmptyHint {
    color: @text_muted;
    font-size: @fs_smallpx;
}
QLabel#EmptyKey {
    color: @text;
    background: @surface;
    border-radius: 4px;
    padding: 1px 6px;
    font-size: @fs_smallpx;
}
QFrame#Toast {
    background: @surface;
    border: 1px solid @border;
    border-radius: @r_panelpx;
}
QFrame#Toast QLabel {
    background: transparent;
    color: @text;
}

/* ---------- Seitenleiste: Hinweise ---------- */
QLabel#TreeHint {
    color: @text_faint;
    background: transparent;
    font-size: @fs_smallpx;
}
QLabel#ResultsInfo {
    color: @text_muted;
    background: transparent;
    font-size: @fs_smallpx;
    padding-right: @sp_xspx;
}
QLabel#StatusDot {
    color: @text_faint;
    padding: 0;
}
